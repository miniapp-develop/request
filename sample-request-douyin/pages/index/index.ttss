.container {
    padding: 24rpx;
}

.header {
    font-size: 36rpx;
    font-weight: 600;
    margin-bottom: 16rpx;
}

.result {
    background: #fff;
    border-radius: 12rpx;
    padding: 24rpx;
    font-size: 26rpx;
    color: #333;
    min-height: 120rpx;
    white-space: pre-wrap;
    word-break: break-all;
    margin-bottom: 24rpx;
}

.section-title {
    font-size: 26rpx;
    color: #999;
    margin: 24rpx 0 12rpx;
}

.action {
    background: #fff;
    border-radius: 12rpx;
    padding: 24rpx;
    font-size: 28rpx;
    color: #1677ff;
    margin-bottom: 12rpx;
}
